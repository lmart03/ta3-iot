# Copiar a .env y cambiar los valores. NO subir .env a Git.

# --- InfluxDB ---
INFLUXDB_ORG=utp
INFLUXDB_BUCKET=smart_environment
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=cambiar-esta-clave-123
# Token de API (cadena larga aleatoria). Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INFLUXDB_TOKEN=cambiar-este-token

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambiar-esta-clave-123

# --- EMQX ---
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=cambiar-esta-clave-123

# --- MQTT (ingestor). Vacio = sin autenticacion (broker local de demostracion) ---
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC=smart-environment/+/telemetry

# --- Puente al broker publico (el ESP32 de Wokwi publica en <prefijo>/smart-environment/...) ---
# Debe coincidir con el inicio de MQTT_TOPIC_BASE en firmware/esp32/platformio.ini. Usar un valor aleatorio propio.
BRIDGE_TOPIC_PREFIX=cambiar-prefijo-aleatorio
