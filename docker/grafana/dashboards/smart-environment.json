      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influx-flux"
          },
          "refId": "A",
          "query": "from(bucket: \"smart_environment\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"environment\" and r.device_id == \"${device}\" and r._field == \"temperature\")\n  |> last()"
