            "type": "influxdb",
            "uid": "influx-flux"
          },
          "refId": "A",
          "query": "from(bucket: \"smart_environment\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"environment\" and r.device_id == \"${device}\" and r._field == \"motion\")\n  |> map(fn: (r) => ({r with _value: if r._value then 1 else 0}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NO",
                  "color": "#2ecc71"
                },
                "1": {
                  "text": "MOVIMIENTO",
                  "color": "#f1c40f"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#2ecc71",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom",
          "displayMode": "list"
        },
        "mergeValues": true,
        "showValue": "auto"
      }
    }
  ]
}
