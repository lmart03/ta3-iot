{
  "version": 1,
  "author": "Equipo TA3 - Smart Environment IoT",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 70, "left": 300, "attrs": {} },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": -70,
      "left": 20,
      "attrs": { "temperature": "25", "humidity": "60" }
    },
    {
      "type": "wokwi-photoresistor-sensor",
      "id": "ldr1",
      "top": 108.8,
      "left": 20,
      "attrs": { "lux": "500" }
    },
    {
      "type": "wokwi-pir-motion-sensor",
      "id": "pir1",
      "top": 290,
      "left": 35,
      "attrs": { "delayTime": "5", "inhibitTime": "1.2" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "dht1:VCC", "esp:3V3", "red", [ "h90", "v120" ] ],
    [ "dht1:SDA", "esp:15", "green", [ "h120", "v110" ] ],
    [ "dht1:GND", "esp:GND.1", "black", [ "h150", "v150" ] ],
    [ "ldr1:VCC", "esp:3V3", "red", [ "h100", "v-10", "h40" ] ],
    [ "ldr1:AO", "esp:34", "orange", [ "h120", "v0", "h35" ] ],
    [ "ldr1:GND", "esp:GND.1", "black", [ "h140", "v20", "h30" ] ],
    [ "pir1:VCC", "esp:3V3", "red", [ "h110", "v-120", "h35" ] ],
    [ "pir1:OUT", "esp:27", "purple", [ "h140", "v-95", "h25" ] ],
    [ "pir1:GND", "esp:GND.1", "black", [ "h160", "v-70", "h20" ] ]
  ],
  "dependencies": {}
}